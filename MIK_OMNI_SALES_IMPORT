													   p_begin_time=>v_BeginDateTime,
													   p_orig_tran=>null,
													   p_orig_reg=>null,
													   p_rounded_amount=>v_amount,
													   p_tender_control =>v_tender_control,
													   p_total_tax_amt =>null); 

		l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_MIK_SA_HEAD_STG_IN_INS Completed for Control TransactionID' || ':' || l_TRANSACTION_OBJECT.TransactionID || ' and stgId'|| ':'||v_stgId;
		utl_file.put_line(g_omni_err_file_type, l_buffer);
        l_error_code := esb_api_codes.success;
	ELSE
	IF l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL IS NOT NULL    AND l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL.COUNT > 0 THEN
		FOR custorder_rec IN 1 .. l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL.COUNT LOOP

			BEGIN

			SELECT
			   (CASE
					WHEN MAX(CASE WHEN LIBT.Quantity > 0 THEN 1 ELSE 0 END) = 1 
					THEN '1'
					ELSE '0'
				END) into v_tran_type_code
			FROM TABLE(CAST(l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).p_LineItem_OBJECT_TBL AS LineItem_OBJECT_TBL)) LIBT
			where LIBT.CancelFlag='false';

			 EXCEPTION
            WHEN NO_DATA_FOUND THEN 
              l_error_code := esb_api_codes.validation_failure;
              l_error_mesg := 'No rows returned for v_tran_type_code for TransactionID = ' || l_TRANSACTION_OBJECT.TransactionID ||'. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE validation_failure;
			END;

			BEGIN

			SELECT 'INTDY','R' into v_sys_code,v_exp_status FROM DUAL;

			END;


					v_type_code         := l_TRANSACTION_OBJECT.TypeCode;
					v_TrainingModeFlag  := l_TRANSACTION_OBJECT.TrainingModeFlag;
					v_UnitID            := l_TRANSACTION_OBJECT.UnitID;
					v_WorkstationID     := l_TRANSACTION_OBJECT.WorkstationID;
					v_tran_num          := l_TRANSACTION_OBJECT.SequenceNumber;
					v_TransactionID     := l_TRANSACTION_OBJECT.TransactionID;
					v_OperatorID        := REGEXP_REPLACE(l_TRANSACTION_OBJECT.OperatorID, '[[:alpha:]]', '9');
					v_Currency          := l_TRANSACTION_OBJECT.Currency;
					v_TillID            := l_TRANSACTION_OBJECT.TillID;
					v_plcc_app_date     := TO_CHAR(TO_DATE(l_TRANSACTION_OBJECT.BusinessDayDate,'YYYY-MM-DD HH24:MI:SS'),'YYMMDD');
					v_day               := TO_CHAR(TO_DATE(l_TRANSACTION_OBJECT.BusinessDayDate,'YYYY-MM-DD HH24:MI:SS'),'DD');
					v_BusinessDayDate   := TO_DATE(l_TRANSACTION_OBJECT.BusinessDayDate,'YYYY-MM-DD HH24:MI:SS');
					v_Bankingday := TO_DATE(l_TRANSACTION_OBJECT.BankingDay,'YYYY-MM-DD HH24:MI:SS');
					v_BeginDatetimeoffset := l_TRANSACTION_OBJECT.BeginDatetimeoffset;
					v_EndDatetimeoffset := l_TRANSACTION_OBJECT.EndDatetimeoffset;

					v_begin_sign              := CASE WHEN SUBSTR(v_BeginDatetimeoffset, 1, 1) = '-' THEN -1 ELSE 1 END;
                    v_begin_hours             := TO_NUMBER(SUBSTR(v_BeginDatetimeoffset, 2, 2));    
                    v_begin_mins              := TO_NUMBER(SUBSTR(v_BeginDatetimeoffset, 5, 2));
					v_end_sign              := CASE WHEN SUBSTR(v_EndDatetimeoffset, 1, 1) = '-' THEN -1 ELSE 1 END;
                    v_end_hours             := TO_NUMBER(SUBSTR(v_EndDatetimeoffset, 2, 2));    
                    v_end_mins              := TO_NUMBER(SUBSTR(v_EndDatetimeoffset, 5, 2));
                    v_BeginDateTime     := TO_TIMESTAMP(l_TRANSACTION_object.BeginDateTime,'YYYY-MM-DD HH24:MI:SS')  + v_begin_sign * NUMTODSINTERVAL(v_begin_hours, 'HOUR') + v_begin_sign * NUMTODSINTERVAL(v_begin_mins, 'MINUTE');
                    v_EndDateTime       := TO_TIMESTAMP(l_TRANSACTION_object.EndDateTime,'YYYY-MM-DD HH24:MI:SS')  + v_end_sign * NUMTODSINTERVAL(v_end_hours, 'HOUR') + v_end_sign * NUMTODSINTERVAL(v_end_mins, 'MINUTE');
					v_depositdate       := TO_CHAR(TO_DATE(l_TRANSACTION_OBJECT.BusinessDayDate,'YYYY-MM-DD HH24:MI:SS'),'YYMMDD');
					v_TransactionStatus := l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).TransactionStatus;
					v_total             := l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).Total;
					v_emp_disc_ind      := l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).EmployeeDiscountApplied;

					v_tran_link_Typecode :=l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).Link_Typecode;
					v_tran_link_TranID   :=l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).Link_TransactionID;
					v_tran_link_Reason   :=l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).Link_Reason;						 
					v_tran_type 		 := case 
					                         WHEN v_type_code='RetailTransaction' and v_tran_link_Typecode='PostVoid' then 'PVOID' 
											 when v_type_code='RetailTransaction' AND v_TransactionStatus='Finished' and v_tran_type_code=1 then 'SALE' 
											 when v_type_code='RetailTransaction'  AND v_TransactionStatus='Finished' and v_tran_type_code=0 then 'RETURN' 
											 when v_type_code='NoSale' then 'NOSALE'											 
											 WHEN v_type_code='RetailTransaction' AND v_TransactionStatus='Voided' then 'VOID' 
											 WHEN v_type_code='Deposit' Then 'TOTAL'
											 WHEN v_type_code='RegisterCashOut' Then 'RETURN'
											 ELSE 'VOID'
										    end;

					v_sub_tran_type 	:= case when v_emp_disc_ind='true' then 'EMP' 
					                       else (case when v_tran_type in('TOTAL','DCLOSE','PVOID') then null else v_tran_type end)	end;
					v_total_type		:= l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).TenderType;
					v_ref_no1   		:= case when v_tran_type='TOTAL' and v_total_type='Cash' then '1390' when v_tran_type='DCLOSE' then '2' else v_TransactionID end;
					v_ref_no4           := null;
					v_loyalty_id        := l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).LoyaltyID;
