create or replace PACKAGE BODY      MIK_OMNI_SALES_IMPORT

IS
  program_error              EXCEPTION;
  validation_failure         EXCEPTION;
  too_many_rows              EXCEPTION;
  v_stgId                    NUMBER;
  l_error_code               NUMBER (10)     := 0;
  l_error_mesg               VARCHAR2 (4000) := NULL;
  l_TRANSACTION_OBJECT       TRANSACTION_OBJECT;
  g_omni_err_file_type utl_file.file_type;

  PROCEDURE PROC_LOG_IMPORT_ERROR (
    p_error_code      IN NUMBER,
    p_error_message   IN VARCHAR2,
    p_transaction_id  IN VARCHAR2,
    p_stg_id          IN NUMBER,
    p_message_id      IN VARCHAR2,
    p_procedure_name  IN VARCHAR2,
    p_poslog_data     IN CLOB
  )
  IS
    PRAGMA AUTONOMOUS_TRANSACTION;
    l_buffer VARCHAR2(5000);
  BEGIN
    INSERT INTO MIK.MIK_OMNI_IMPORT_ERROR_LOG (
      ERROR_ID,
      ERROR_CODE,
      ERROR_MESSAGE,
      TRANSACTION_ID,
      STG_ID,
      MESSAGE_ID,
      PROCEDURE_NAME,
      POSLOG_DATA,
      ERROR_TIMESTAMP,
      CREATED_BY
    ) VALUES (
      MIK.MIK_OMNI_ERROR_LOG_SEQ.NEXTVAL,
      p_error_code,
      p_error_message,
      p_transaction_id,
      p_stg_id,
      p_message_id,
      p_procedure_name,
      p_poslog_data,
      SYSDATE,
      USER
    );
    COMMIT;
  EXCEPTION
  WHEN OTHERS THEN
    BEGIN
      l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') || ':' || 'ERROR: Failed to insert into MIK_OMNI_IMPORT_ERROR_LOG. ' || SQLERRM;
      utl_file.put_line(g_omni_err_file_type, l_buffer);
    EXCEPTION
    WHEN OTHERS THEN
      NULL;
    END;
  END PROC_LOG_IMPORT_ERROR;

