IF l_TRANSACTION_OBJECT IS NOT NULL  THEN
	FOR TRAN_REC IN 1 .. 1 LOOP
	v_stgId := MIK.MIK_SA_HEAD_IN_STG_ID_SEQUENCE.NEXTVAL;

	                v_type_code         := l_TRANSACTION_OBJECT.TypeCode;
