													   p_store=>v_UnitID,
													   p_business_date =>v_BusinessDayDate,
													   p_tran_datetime =>v_EndDateTime,
													   p_register=>v_WorkstationID,
													   p_tran_no=>v_tran_num ,
													   p_cashier=> case when v_OperatorID in ('System','EODUSER') then '999999' else v_OperatorID end,
													   p_salesperson=>case when v_OperatorID in ('System','EODUSER') then '999999' else v_OperatorID end,
													   p_tran_type=>'NOSALE',
													   p_sub_tran_type=>'NOSALE',
													   p_receipt_barcode=>v_TransactionID,
													   p_value=>v_amount,
													   p_ref_no1=>v_TransactionID,
													   p_ref_no4=>case when v_TrainingModeFlag='true' then 'User Training Transaction'   when v_type_code='SafeSessionFinalise' then 'SafeSessionFinalise' when v_type_code='SafeDeclaration' then 'SafeDeclaration'  when v_type_code='RegisterSessionFinalise' then 'RegisterSessionFinalise'  when v_type_code='RegisterSessionDeclaration' then 'RegisterSessionDeclaration' else null   end,
