		l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_MIK_SA_HEAD_STG_IN_INS Started for Control TransactionID' || ':' || l_TRANSACTION_OBJECT.TransactionID || ' and stgId'|| ':'||v_stgId;
