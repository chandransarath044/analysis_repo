					v_total_tax_amt		:=l_TRANSACTION_OBJECT.p_CustomerOrder_OBJECT_TBL(custorder_rec).TotalTaxCollected;
					l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_MIK_SA_HEAD_STG_IN_INS Started for TransactionID' || ':' || l_TRANSACTION_OBJECT.TransactionID || ' and stgId'|| ':'||v_stgId;
					utl_file.put_line(g_omni_err_file_type, l_buffer);

					PROC_SALES_MIK_SA_HEAD_STG_IN_INS (p_stg_Id =>v_stgId ,
													   p_store=>v_UnitID,
													   p_business_date => case when v_tran_type='TOTAL' then v_Bankingday else v_BusinessDayDate end,
													   p_tran_datetime =>v_EndDateTime,
													   p_register=>case when v_tran_type='DCLOSE' then null else v_WorkstationID end,
													   p_tran_no=>case when v_tran_type='DCLOSE' then null when v_tran_type='TOTAL' then 0 else v_tran_num end,
													   p_cashier=>case when v_tran_type='DCLOSE' then null else v_OperatorID end,
													   p_salesperson=>case when v_tran_type in ('DCLOSE','TOTAL') then null else v_OperatorID end,
													   p_tran_type=>v_tran_type,
