                    END IF;
                  END LOOP; --paymentmethod
                END IF;     --paymentmethod
                --     END IF; --payment status id
              END LOOP; --paymentheader
            END;
          END IF;
          v_InvoiceLineSubTotal                                          := 0;
          V_SFS_FLAG                                                     := 0;
          V_STS_FLAG                                                     := 0;
          IF l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL.COUNT > 0 THEN
            FOR InvoiceLine_Rec IN l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL.FIRST .. l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL.LAST
            LOOP
              DBMS_OUTPUT.PUT_LINE('InvoiceLineId:'|| l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).InvoiceLineId);
              -- Validating key column Line Number is not null.
              IF (l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).OrderLineId IS NULL) THEN
                l_error_code                                                                               := esb_api_codes.validation_failure;
                l_error_mesg                                                                               := 'Required value Line Number is Null';
                RAISE validation_failure;
              END IF;
              -- Overriding Invoice Level details with Line Level details for Appeasement Invoices
              IF upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId) = upper('ADJUSTMENT') THEN
                BEGIN
                  SELECT DISTINCT l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).ShipFromLocationId,
                    l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).ShipToLocationId,
                    OLT.DeliveryMethodId
                  INTO v_ShipFromLocationId,
                    v_ShipToLocationId,
                    v_DeliveryMethodId
                  FROM TABLE(CAST(l_ORDER_OBJECT.p_OrderLine_TBL AS OrderLine_TBL)) OLT
                  WHERE OLT.orderlineid                                              = l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).orderlineid
                  AND upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId) = upper('ADJUSTMENT');
                  l_buffer                                                          := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has overridden line level DeliveryMethodId' || ':'|| v_DeliveryMethodId || ', ShipFromLocationId' ||':' || v_ShipFromLocationId|| ', ShipToLocationId' ||':' || v_ShipToLocationId || 'for transactiontype: '||v_trantype;
                  utl_file.put_line(g_err_file_type, l_buffer);
