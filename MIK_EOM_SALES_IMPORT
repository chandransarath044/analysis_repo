                  TABLE(CAST(l_ORDER_OBJECT.p_RELEASE_TBL AS RELEASE_TBL)) RT,
                  TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL AS InvoiceLine_TBL)) ILT
                WHERE RT.Releaseid              = FDT.Releaseid --OR upper(v_DeliveryMethodID) = upper('Email')
                AND FDT.StatusId                = '7000'
                AND upper(RT.DestinationAction) = upper('Merge')
                AND upper(v_DeliveryMethodID)   = upper('ShipToStore')
                AND ILT.ContextId               = FDT.ContextID
                AND rownum                      = 1 ;
                l_buffer                       := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber Fetch at ShipToStore case';
                utl_file.put_line(g_err_file_type, l_buffer);
              EXCEPTION
              WHEN NO_DATA_FOUND THEN
                NULL;
              WHEN TOO_MANY_ROWS THEN
                l_error_code := esb_api_codes.too_many_rows_err;
                l_error_mesg := 'More than one row returned for fulfil_extended_tbl (ShipToStore) for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
                RAISE too_many_rows;
              END;
            WHEN upper(v_DeliveryMethodID) = upper('Email') THEN
              BEGIN
                SELECT FDT.p_extended_tbl
                INTO v_fulfil_extended_tbl
                FROM TABLE(CAST(v_FulfillmentDetail_TBL AS FulfillmentDetail_TBL)) FDT,
                  TABLE(CAST(l_ORDER_OBJECT.p_RELEASE_TBL AS RELEASE_TBL)) RT
                WHERE RT.Releaseid            = FDT.Releaseid
                AND FDT.StatusId              = '7000'
                AND RT.DestinationAction     IS NULL
                AND upper(v_DeliveryMethodID) = upper('Email');
                l_buffer                     := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber Fetch at Email case';
                utl_file.put_line(g_err_file_type, l_buffer);
              EXCEPTION
              WHEN NO_DATA_FOUND THEN
                NULL;
              WHEN TOO_MANY_ROWS THEN
                l_error_code := esb_api_codes.too_many_rows_err;
                l_error_mesg := 'More than one row returned for fulfil_extended_tbl (Email) for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
                RAISE too_many_rows;
              END;
            ELSE
              BEGIN
                SELECT FDT.p_extended_tbl
                INTO v_fulfil_extended_tbl
                FROM TABLE(CAST(v_FulfillmentDetail_TBL AS FulfillmentDetail_TBL)) FDT,
                  TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL AS Invoice_TBL)) IT,
                  TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL AS InvoiceLine_TBL)) ILT
                WHERE FDT.packageid = IT.packageid
                AND FDT.StatusId    = '7000'
                AND IT.invoiceid    = l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId
                AND ILT.ContextId   = FDT.ContextID
                AND rownum          = 1 ;
                l_buffer           := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber Fetch at Default case';
                utl_file.put_line(g_err_file_type, l_buffer);
              EXCEPTION
              WHEN NO_DATA_FOUND THEN
                NULL;
              WHEN TOO_MANY_ROWS THEN
                l_error_code := esb_api_codes.too_many_rows_err;
                l_error_mesg := 'More than one row returned for fulfil_extended_tbl (Else) for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
                RAISE too_many_rows;
              END;
            END CASE ;
            IF v_fulfil_extended_tbl IS NOT NULL AND v_fulfil_extended_tbl.COUNT > 0 THEN
              FOR Fulfill_Extd_Rec IN v_fulfil_extended_tbl.FIRST .. v_fulfil_extended_tbl.LAST
              LOOP
                l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber b4 if name' || ':'|| v_fulfil_extended_tbl(Fulfill_Extd_Rec).Name ||' and Value:' || v_fulfil_extended_tbl(Fulfill_Extd_Rec).value;
                utl_file.put_line(g_err_file_type, l_buffer);
                IF v_fulfil_extended_tbl(Fulfill_Extd_Rec).Name = 'ReturnBarcodeNumber' AND v_fulfil_extended_tbl(Fulfill_Extd_Rec).value IS NOT NULL THEN
                  v_ReturnBarcodeNumber                        := v_fulfil_extended_tbl(Fulfill_Extd_Rec).value;
                  l_buffer                                     := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber in if' || ':'|| v_ReturnBarcodeNumber;
                  utl_file.put_line(g_err_file_type, l_buffer);
                END IF;
              END LOOP; --fulfilmentdetail_extended
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||' InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnBarcodeNumber in end of loop' || ':'|| v_ReturnBarcodeNumber;
              utl_file.put_line(g_err_file_type, l_buffer);
            ELSE
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'FulfillmentDetail_Extended_TBL is null for InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' and PackageId' || ':'|| v_PackageId;
              utl_file.put_line(g_err_file_type, l_buffer);
            END IF;
            --RBN Changes End
          ELSE
            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'FulfillmentDetail_TBL is null for InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' and Orderlineid'||':'|| v_orderlineid;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;
          /* Setting v_InvoiceId to pass to all procedures for insertion - Appending InvoiceNumber with R if the invoice status is canceled */
          /*IF Upper(v_trantype) = Upper('RETURN') AND Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN
            v_InvoiceId       := l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId||'R';*/

		  /* Setting v_InvoiceId to pass to all procedures for insertion - Appending InvoiceNumber with first letter of reversed transaction type if the invoice status is canceled */
		  IF Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN
            v_InvoiceId := l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || Upper(substr(v_trantype,1,1));
          ELSE
            v_InvoiceId := l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
          END IF;
          DBMS_OUTPUT.PUT_LINE('MIK_SALES_TRAN_HEAD');
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_HEAD_INS Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
          utl_file.put_line(g_err_file_type, l_buffer);
          --MIK_SALES_TRAN_HEAD
          PROC_SALES_TRAN_HEAD_INS( p_batchId => v_batchId, p_storeid => v_FacilityId, p_ORDERTYPE => l_ORDER_OBJECT.OrderTypeId, p_TRANSACTIONNUMBER => l_ORDER_OBJECT.OrderId, p_TRANSACTIONTYPE => v_trantype,
          /* Modified the Timezone to CST v 1.1 */
          p_TRANSACTIONDATETIME => from_tz(to_timestamp(to_char(from_tz(to_timestamp(l_ORDER_OBJECT.CapturedDate,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),'GMT') at time zone 'US/Central','DD-MON-YYYY HH24:MI:SS'),'DD-MON-YYYY HH24:MI:SS'),dbtimezone),
          --from_tz(to_timestamp (l_ORDER_OBJECT.CapturedDate,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone), --to_timestamp_tz(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),                                             --to_date(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD'),
          p_SHIPDATETIME => from_tz(to_timestamp(to_char(from_tz(to_timestamp(v_SHIPDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),'GMT') at time zone 'US/Central','DD-MON-YYYY HH24:MI:SS'),'DD-MON-YYYY HH24:MI:SS'),dbtimezone),
          --from_tz(to_timestamp (v_SHIPDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone),                                                                                                                                                                                                                                                            --to_timestamp_tz(v_SHIPDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),                                                                                                                                                                                                                                                                                                       --'yyyy-mm-dd"T"hh24:mi:ss.tzh:tzm',
          p_RETURNDATETIME => from_tz(to_timestamp(to_char(from_tz(to_timestamp(v_RETURNDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),'GMT') at time zone 'US/Central','DD-MON-YYYY HH24:MI:SS'),'DD-MON-YYYY HH24:MI:SS'),dbtimezone),
          --from_tz(to_timestamp (v_RETURNDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone),                                                                                                                                                                                                                                                         --to_timestamp_tz(v_RETURNDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),                                                                                                                                                                                                                                                                                                    -- to_date(v_RETURNDATETIME,'YYYY-MM-DD'),
          /* Modified the Timezone to CST v 1.1 */
          p_INVOICEDATETIME =>
          CASE
            /* Overriding InvoiceDate with SYSTIMESTAMP if the invoice status is canceled */
          WHEN Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN	/* Removed condition for Return and made it general for any canceled invoice */
            from_tz(to_timestamp(TO_CHAR(systimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone)
          ELSE
--            from_tz(to_timestamp(NEW_TIME(to_timestamp(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), 'GMT', 'CST'),'DD-MON-YYYY HH24:MI:SS'),dbtimezone)
            from_tz(to_timestamp(to_char(from_tz(to_timestamp(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),'GMT') at time zone 'US/Central','DD-MON-YYYY HH24:MI:SS'),'DD-MON-YYYY HH24:MI:SS'),dbtimezone)
--            from_tz(to_timestamp (l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone)
          END,                                                                                                                                                                                                  --to_timestamp_tz(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),                                                                                                                                                                                                                                                        --to_date(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD'),
          p_SHIPMENTNUMBER => v_ShipmentId, p_INVOICENUMBER => v_InvoiceId, p_WEBORDERNUMBER => l_ORDER_OBJECT.OrderId, p_FacilityId => v_FacilityId, p_ORIGINALTRANSACTIONNO => NULL,                          --l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).ParentOrderId,
          p_ORIGINALTRANSACTIONDATETIME => from_tz(to_timestamp (v_ORIGINALTRANSACTIONDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone),                                                                     --to_timestamp_tz(v_ORIGINALTRANSACTIONDATETIME,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), --to_date(v_ORIGINALTRANSACTIONDATETIME,'YYYY-MM-DD'),
          p_LOYALTYACCOUNTNUMBER => v_LoyaltyAccountNumber, p_RECORDCREATEDDATE =>from_tz(to_timestamp (l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'), dbtimezone), --to_timestamp_tz(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD"T"HH24:MI:SS.FF3'),                                                                                                                                                                                                     -- to_date(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp,'YYYY-MM-DD'),
          p_MESSAGEID => v_batchId, p_OMSORDERID => v_ReleaseId, p_EXTERNALSHIPMENTID => v_ReturnBarcodeNumber, p_CUSTOMERORDERID => l_ORDER_OBJECT.OrderId, p_EXTERNALFACILITYID => CASE WHEN v_ExternalFacilityId=v_Popupstore THEN v_Popextstore ELSE v_ExternalFacilityId END, --/* 1.12 */
		  p_OMSORDERNUMBER => l_ORDER_OBJECT.OrderId, p_ORIGINALOMSORDERNUMBER => l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).ParentOrderId,
          p_ParentCustomerNumber => v_ParentCustomerNumber, p_ChildCustomerNumber => v_ChildCustomerNumber, p_PurchaseOrderNumber => v_PurchaseOrderNumber, p_SalesPersonID => v_SalesPersonID, p_SalesPersonName => v_SalesPersonName,p_head_ref_2 => CASE WHEN v_ExternalFacilityId=v_Popupstore THEN 'POP_STORE' ELSE NULL END);
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_HEAD_INS Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
          utl_file.put_line(g_err_file_type, l_buffer);
          IF upper(v_DeliveryMethodID) = upper('Email') THEN
            l_buffer                  := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_TEND_INS for DeliveryMethodID ''Email'' Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
            utl_file.put_line(g_err_file_type, l_buffer);
            PROC_SALES_TRAN_TEND_INS( p_batchId =>v_batchId, p_FacilityId =>v_FacilityId, p_InvoiceId => v_InvoiceId, p_TENDERTYPE => 'Reissue', p_PAYMENTREFERENCE => 'Reissue', p_TENDERAMOUNT => v_GiftCardValue, p_CurrencyCode => l_ORDER_OBJECT.CurrencyCode, p_AccountNumber => NULL, p_ACCOUNTEXPIRATIONDATE => NULL, p_PAYMENTREFERENCE1 => NULL, p_DISPLAYCREDITCARDNUMBER => NULL, p_AUTHCODE => NULL,p_AUTHAMOUNT => NULL,p_PROMOCD => NULL,p_PARENTORDERID => NULL,p_TOKENEXPIRY=>NULL,p_CARDTOKEN=>NULL );  --1.7
            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_TEND_INS for DeliveryMethodID ''Email'' Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;

          IF l_ORDER_OBJECT.p_PaymentHeader_TBL IS NOT NULL AND l_ORDER_OBJECT.p_PaymentHeader_TBL.COUNT > 0 THEN
            BEGIN
              FOR PaymentHeader_Rec IN l_ORDER_OBJECT.p_PaymentHeader_TBL.FIRST .. l_ORDER_OBJECT.p_PaymentHeader_TBL.LAST
              LOOP
                l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId|| ' has PaymentStatusId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).PaymentStatusId;
                utl_file.put_line(g_err_file_type, l_buffer);
                --     IF l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).PaymentStatusId IN ('5000.000','7000.000') THEN
                IF l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL IS NOT NULL AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL.COUNT > 0 THEN
                  FOR PaymentMethod_Rec IN l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL.FIRST .. l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL.LAST
                  LOOP
                    DBMS_OUTPUT.PUT_LINE ('PaymentTypeId:'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId);
                    l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId|| ' has PaymentTypeId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId;
                    utl_file.put_line(g_err_file_type, l_buffer);
                    -- Validating key column Payment Reference is not null.
                    IF (l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId IS NULL) THEN
                      l_error_code                                                                                                 := esb_api_codes.validation_failure;
                      l_error_mesg                                                                                                 := 'Required value Payment Reference is Null';
                      RAISE validation_failure;
                    END IF;
                    IF l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL IS NOT NULL AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL.COUNT > 0 THEN
                      FOR PaymentTrans_Rec IN l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL.FIRST .. l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL.LAST
                      LOOP
                        l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId||
                        --' has PaymentStatusId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).PaymentStatusId||
                        --', PaymentTypeId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId||
                        ' has PaymentTransactionTypeId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).PaymentTransactionTypeId;
                        utl_file.put_line(g_err_file_type, l_buffer);
                        IF upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).PaymentTransactionTypeId) IN (upper('Settlement'),upper('Refund')) AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).ProcessedAmount <> 0 THEN
                          v_PaymentTranscDetail_TBL :=l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).p_PaymentTranscDetail_TBL;
                          DBMS_OUTPUT.PUT_LINE('PaymentTransactionTypeId:'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).PaymentTransactionTypeId);
                          BEGIN
                            DBMS_OUTPUT.PUT_LINE('Tender InvoiceId: '||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId);
                            FOR tender_amt IN
                            (SELECT PTD.AMOUNT
                              --INTO v_TENDERAMOUNT
                            FROM TABLE(CAST(v_PaymentTranscDetail_TBL AS PaymentTranscDetail_TBL)) PTD,
                              TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL AS Invoice_TBL)) IT
                            WHERE PTD.ReferenceId                     = IT.invoiceid
                            AND upper(PTD.TransactionReferenceTypeId) = upper('Invoice')
                            AND IT.invoiceid                          =l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId
                            )
                            LOOP
                              DBMS_OUTPUT.PUT_LINE('TenderAmt: '||tender_amt.amount);
                              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId|| ' has PaymentStatusId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).PaymentStatusId|| ', PaymentTransactionTypeId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).PaymentTransactionTypeId|| ', PaymentTypeId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId|| ', TenderAmount' || ':'||tender_amt.amount;
                              utl_file.put_line(g_err_file_type, l_buffer);
                              BEGIN
                                DBMS_OUTPUT.PUT_LINE('CARDTYPE:'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId);
                                l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId|| ' has CardTypeId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId;
                                --', PaymentTypeId' || ':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId;
                                utl_file.put_line(g_err_file_type, l_buffer);
                                SELECT

		                              CASE WHEN upper(l_ORDER_OBJECT.OrderTypeId)= upper('MCF') --1.8
		                              THEN DECODE(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId,'Visa','VC','Master','MC','Discoverer','DC','Amex','AM',l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId)
		                              ELSE
		                              (CASE
		                              WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('CC') --upper('Credit Card')
                                                                    --THEN DECODE(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId,'Visa','VC','Master','MC','Discoverer','DC','Amex','AM',l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId)
                                      THEN l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardTypeId
                                                                  /* Version 1.1 starts*/
                                      When Upper(L_Order_Object.P_Paymentheader_Tbl(Paymentheader_Rec).P_Paymentmethod_Tbl(Paymentmethod_Rec).Paymenttypeid) = Upper('GC')
		                              Then Nvl((Select Distinct Description From Mik_Eref_Map
                                      where ref_code in ( 'GCAC' ,'GCLY') and  -- Included GCLY to consider loyalty account number as PC tender
		                              				  ((l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountNumber >= ecom_value
                                                         AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountNumber <= resa_value)
		                              				   Or ( L_Order_Object.P_Paymentheader_Tbl(Paymentheader_Rec).P_Paymentmethod_Tbl(Paymentmethod_Rec).Accountnumber >= Ecom_Value
                                                       And L_Order_Object.P_Paymentheader_Tbl(Paymentheader_Rec).P_Paymentmethod_Tbl(Paymentmethod_Rec).Accountnumber <= Resa_Value) ) and rownum=1),'SP')
                                    /* Version 1.1 ends*/
                                      WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PayPal')
                                      THEN 'PY'
                                      WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('Reissue')
                                      THEN 'Reissue'
                                      WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('LC')
                                      THEN 'LC'
		                              WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('AF')
                                      THEN 'AF'
		                              							/* Version 1.3 starts*/
		                              WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PL')
                                      THEN 'PL'
		                              							/* Version 1.3 Ends*/
                                      END) END AS tendertype,
                                                                --   DECODE(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId,upper('Credit Card'),'CC',upper('Gift Card'),'GC',upper('PayPal'),'PAYPAL',upper('Reissue'),'Reissue') AS PAYMENTREFERENCE,
                                      DECODE(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId,'PAYPAL','true',NULL) AS PAYMENTREFERENCE1
                                      INTO V_TENDERTYPE,
                                            --v_PAYMENTREFERENCE,
                                           v_PAYMENTREFERENCE1
                                     FROM dual;
                                DBMS_OUTPUT.PUT_LINE('TENDERTYPE:'||V_TENDERTYPE||'PAYMENTREFERENCE1:'||v_PAYMENTREFERENCE1);
                              EXCEPTION
                              WHEN NO_DATA_FOUND THEN
                                NULL;
