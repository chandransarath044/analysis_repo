                WHEN NO_DATA_FOUND THEN
                  l_error_code := esb_api_codes.validation_failure;
                  l_error_mesg := 'No rows returned for overriding creditmemo invoice line level details for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
