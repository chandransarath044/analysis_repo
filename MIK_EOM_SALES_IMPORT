                                l_error_mesg := 'More than one row returned for Tender type and Payment Reference for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
                                RAISE too_many_rows;
                              END;
                              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss')||':' || 'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId|| ' has PaymentStatusId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).PaymentStatusId|| ', PaymentTransactionTypeId' ||':'||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).PaymentTransactionTypeId|| ', PaymentTypeId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId|| ', AccountNumber' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountNumber|| ', AccountExpirationDate' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryMonth||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryYear ||
                              ', AccountDisplayNumber' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountDisplayNumber|| ', RequestId' || ':' || l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).RequestId|| ', TenderType' || ':'|| v_TENDERTYPE|| ', TenderAmount' || ':'||tender_amt.amount;
                              utl_file.put_line(g_err_file_type, l_buffer);
                              DBMS_OUTPUT.PUT_LINE('MIK_SALES_TRAN_TEND');
                              IF (tender_amt.amount IS NOT NULL AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId IS NOT NULL) THEN
                                l_buffer            := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_TEND_INS Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                                utl_file.put_line(g_err_file_type, l_buffer);
                                PROC_SALES_TRAN_TEND_INS( p_batchId =>v_batchId, p_FacilityId =>v_FacilityId, p_InvoiceId => v_InvoiceId, p_TENDERTYPE => v_TENDERTYPE, 
							 	p_PAYMENTREFERENCE => CASE WHEN upper(l_ORDER_OBJECT.OrderTypeId)= upper('MCF') --1.8
                                                      THEN (CASE WHEN v_TENDERTYPE IN ('VC','MC','DC','AM') THEN 'CC' WHEN  v_TENDERTYPE='PY' THEN 'PAYPAL' else v_TENDERTYPE end )
                                                      ELSE l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId end, --v_PAYMENTREFERENCE,
                                p_TENDERAMOUNT =>
                                CASE
                                WHEN Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN /* Removed condition for Return and made it general for any canceled invoice */
                                  -(tender_amt.amount)	/* Removed absolute condition and made it general for any canceled invoice */

                                ELSE
                                  tender_amt.amount
                                END,
                                p_CurrencyCode => l_ORDER_OBJECT.CurrencyCode, p_AccountNumber => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountNumber, p_ACCOUNTEXPIRATIONDATE =>
                                CASE
                                WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PayPal') THEN
                                  '100'
								  /* Version 1.3 starts*/
								WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PL') THEN
                                  '200'
