              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN
              NULL;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
              l_error_mesg := 'More than one row returned for PackageId for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE too_many_rows;
