                        END;
                        IF (l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO.Address1 IS NOT NULL) THEN
                          IF V_FLG1                                                                                                                                                      = 0 THEN
                            l_buffer                                                                                                                                                    := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CUST_INS (B) Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                            PROC_SALES_TRAN_CUST_INS( p_batchId => v_batchId, p_FacilityId => v_FacilityId, p_InvoiceId => v_InvoiceId, p_AddressType => 'B', p_OrderlineId => NULL,--v_OrderLineId,--l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).OrderlineId,
                            p_CustomerId => l_ORDER_OBJECT.CustomerId, p_CustomerFirstName => l_ORDER_OBJECT.CustomerFirstName, p_CustomerLastName => l_ORDER_OBJECT.CustomerLastName, p_CustomerEmail => l_ORDER_OBJECT.CustomerEmail, p_CompanyName => v_CompanyName, p_AddressDTO => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO);
                            --V_FLG1 := 1;
                            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CUST_INS (B) Completed for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                          END IF;
                          IF v_DeliveryMethodId = 'Email' AND V_EMAIL_SHIP_ADDR_FLAG = 0 THEN
                            l_buffer           := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CUST_INS (S-Email) Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                            PROC_SALES_TRAN_CUST_INS( p_batchId => v_batchId, p_FacilityId => v_FacilityId, p_InvoiceId => v_InvoiceId, p_AddressType => 'S', p_OrderlineId => v_OrderLineId,--l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL(InvoiceLine_Rec).OrderlineId,
                            p_CustomerId => l_ORDER_OBJECT.CustomerId, p_CustomerFirstName => l_ORDER_OBJECT.CustomerFirstName, p_CustomerLastName => l_ORDER_OBJECT.CustomerLastName, p_CustomerEmail => l_ORDER_OBJECT.CustomerEmail, p_CompanyName => v_CompanyName, p_AddressDTO => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO);
                            V_EMAIL_SHIP_ADDR_FLAG := 1;
                            l_buffer               := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CUST_INS (S-Email) Completed for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                          END IF;
                        END IF;
                        DBMS_OUTPUT.PUT_LINE('MIK_SALES_TRAN_PHONE');
                        BEGIN
                          SELECT COUNT(1)
                          INTO V_FLG2
                          FROM MIK_SALES_TRAN_PHONE
                          WHERE BATCH_ID    = v_batchId
                          AND INVOICENUMBER = l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId
                            --AND LINENUMBER    = v_OrderLineId
                          AND ADDRESS_TYPE = 'B';
                        EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                          V_FLG2 := 0;
                        END;
                        IF (l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO.Phone IS NOT NULL) THEN
                          IF V_FLG2                                                                                                                                                   = 0 THEN
                            l_buffer                                                                                                                                                 := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_PHONE_INS (B) Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                            PROC_SALES_TRAN_PHONE_INS(p_batchId => v_batchId, p_FacilityId => v_FacilityId, p_InvoiceId => v_InvoiceId, p_AddressType => 'B', p_OrderlineId => NULL,--v_OrderLineId,
                            p_AddressDTO => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO);
                            --V_FLG2 := 1;
                            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_PHONE_INS (B) Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
