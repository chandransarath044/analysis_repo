              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'OrderId'||':' ||l_ORDER_OBJECT.OrderId||' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' fulfilment detail fetch for Orderlineid'||':'|| v_orderlineid;
              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN
              NULL;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
