                                ELSE
                                  l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryMonth||SUBSTR(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryYear,-2)
                                END, p_PAYMENTREFERENCE1 => v_PAYMENTREFERENCE1, p_DISPLAYCREDITCARDNUMBER =>
                                CASE
                                WHEN upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PayPal') THEN
                                  'YPAL'
                                ELSE
                                  SUBSTR(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountDisplayNumber,-4)
                                END,              -- l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).AccountDisplayNumber,
                                p_AUTHCODE => substr(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).RequestId,1,18), p_AUTHAMOUNT => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).REFERENCE_1,
								p_PROMOCD => case when upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PL') 
								THEN 
								l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).REFERENCE_2 else NULL END,
								p_PARENTORDERID => case when upper(l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).PaymentTypeId) = upper('PL') 
								then
								l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).p_PaymentTrans_TBL(PaymentTrans_Rec).REFERENCE_3 else NULL end,
								p_TOKENEXPIRY => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryYear||l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CardExpiryMonth, --1.7
								p_CARDTOKEN => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).CARDTOKEN --1.7
								);
                                l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_TEND_INS Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                                utl_file.put_line(g_err_file_type, l_buffer);
                              END IF;
                            END LOOP;
                            --                          EXCEPTION
                            --                          WHEN NO_DATA_FOUND THEN -- Validating key column Tender Amount is not null.
                            --                            --tender_amt.amount := NULL;
                            --                            --l_error_code := esb_api_codes.validation_failure;
                            --                            --l_error_mesg := 'Required value Tender Amount is Null';
                            --                            --RAISE validation_failure;
                            --                          WHEN TOO_MANY_ROWS THEN
                            --                            l_error_code := esb_api_codes.too_many_rows_err;
                            --                            l_error_mesg := 'More than one row returned for Tender Amount for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
                            --                            RAISE too_many_rows;
                          END;
                        END IF;
                      END LOOP; --paymenttrans
                    END IF;     --payment trans
                    IF l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL IS NOT NULL AND l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL.COUNT > 0 THEN
                      FOR BillingAddress_Rec IN l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL.FIRST .. l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL.LAST
                      LOOP
                        ---- Validating key column Billing Addr AddressLine1 is not null.
                        --IF (l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO.Address1 IS NULL)
                        --   THEN
                        --     l_error_code := esb_api_codes.validation_failure;
