  --p_ReturnLocationId MIK_SALES_TRAN_RETURN_DETAIL.STORE_ID%TYPE;
  --p_ReturnQuantity MIK_SALES_TRAN_RETURN_DETAIL.QUANTITY%TYPE;
  --p_ReturnItemId MIK_SALES_TRAN_RETURN_DETAIL.ITEMID%TYPE;
  --p_ReturnOrderLineId MIK_SALES_TRAN_RETURN_DETAIL.RETURNORDERLINEID%TYPE;
  --p_ReturnItemConditionId MIK_SALES_TRAN_RETURN_DETAIL.ITEMCONDITIONID%TYPE;
  v_marketplace_cnt number;
  v_Popupstore   VARCHAR2(10);  --1.12
  v_Popextstore  VARCHAR2(10);  --1.12
BEGIN
  /* Set Error File Name*/
  --L_ERROR_FILE_NAME := 'MIK_EOM_SALES_IMPORT_LOG'|| '.' || TO_CHAR(sysdate,'YYYYMMDDHH24MI');
  L_ERROR_FILE_NAME := 'MIK_EOM_SALES_IMP_LOG'|| '_' ||P_MESSAGE_ID|| '_' ||P_ORDER_OBJ.OrderId|| '_' || TO_CHAR(sysdate,'YYYYMMDDHH24MI');
  L_DIRECTORY       := 'SALES_LOG'; --'OUT_DIR';--'ERROR_DIR'; 'SALES_LOG';
  /* Opening Error File */
  G_ERR_FILE_TYPE := UTL_FILE.FOPEN(L_DIRECTORY, L_ERROR_FILE_NAME, 'w');
  l_buffer        := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Main Procedure IMPORT_SALES_DATA Started for MESSAGE_ID:'||P_MESSAGE_ID;
  utl_file.put_line(g_err_file_type, l_buffer);
  l_ORDER_OBJECT := P_ORDER_OBJ;
  -- Validating key column MessageId is not null
  IF (P_MESSAGE_ID IS NULL) THEN
    l_error_code   := esb_api_codes.validation_failure;
    l_error_mesg   := 'Required value MessageId is Null';
    RAISE validation_failure;
  END IF;
  l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Pkg esb_inbound_error.check_error Started';
  utl_file.put_line(g_err_file_type, l_buffer);
  IF esb_inbound_error.check_error (i_source => p_source, i_message_id => p_message_id, i_domain => p_domain, i_action => p_action, i_publish_time => p_publish_time, i_queue_name => p_queue_name, i_payload => p_payload, i_key1 => l_order_object.OrderId
    --     i_key2 => l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId
    )              = 1 THEN
    o_status_code := 0;
    RETURN;
    -- There is a failure sitting for this batch id so do not attempt to PROCess it
  END IF;
  l_error_code := esb_api_codes.success;
  l_error_mesg := NULL;
  l_buffer     := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Pkg esb_inbound_error.check_error Completed';
  utl_file.put_line(g_err_file_type, l_buffer);
  IF l_ORDER_OBJECT.p_Invoice_TBL IS NOT NULL AND l_ORDER_OBJECT.p_Invoice_TBL.COUNT > 0 THEN
    FOR Invoice_Rec IN l_ORDER_OBJECT.p_Invoice_TBL.FIRST .. l_ORDER_OBJECT.p_Invoice_TBL.LAST
    LOOP
      BEGIN
        -- Validating key column InvoiceNumber is not null
        IF (l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId IS NULL) THEN
          l_error_code                                          := esb_api_codes.validation_failure;
          l_error_mesg                                          := 'Required value Invoice Number is Null';
          RAISE validation_failure;
        END IF;


	/* 1.9 changes start here .. */

		  IF l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_OrderLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL.COUNT > 0 AND l_ORDER_OBJECT.p_OrderLine_TBL.COUNT >0 THEN
            v_marketplace_cnt := 0;
			BEGIN
              SELECT count(OLT.orderlineid)
              INTO v_marketplace_cnt
              FROM TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL AS InvoiceLine_TBL)) ILT,
                TABLE(CAST(l_ORDER_OBJECT.p_OrderLine_TBL AS OrderLine_TBL)) OLT
              WHERE ILT.orderlineid = OLT.orderlineid
			  and ILT.ItemId = OLT.ItemId
              AND upper(OrderSourceLine) in ('MKT','MKR');
              DBMS_OUTPUT.PUT_LINE('v_orderlineid: '||v_orderlineid);
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'OrderId'||':' ||l_ORDER_OBJECT.OrderId||' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' invoiceline detail fetch for MARKETPLACE invocie details';
              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN
              NULL;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
              l_error_mesg := 'More than one row returned for p_InvoiceLine_TBL for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE too_many_rows;
            END;
          END IF;

         IF v_marketplace_cnt >0 THEN

            DBMS_OUTPUT.PUT_LINE('Invoice Id ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has MARKETPLACE items.');
            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'OrderId'||':' ||l_ORDER_OBJECT.OrderId||' ,Invoice Id ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has MARKETPLACE items.';
            utl_file.put_line(g_err_file_type, l_buffer);
            CONTINUE;

         END IF;

/* 1.9 changes end here .. */


		BEGIN
          SELECT RESA_VALUE
			INTO v_AP_tolerance_value
          FROM mik_eref_map
          WHERE ref_code    = 'SPRC'
          AND ECOM_VALUE	= 'APTV';
          DBMS_OUTPUT.PUT_LINE('Invoice Amount Processed Difference Tolerance Value :' || v_AP_tolerance_value);
          l_buffer := 'Invoice Amount Processed Difference Tolerance Value set as '||':' ||v_AP_tolerance_value;
          utl_file.put_line(g_err_file_type, l_buffer);
        EXCEPTION
        WHEN NO_DATA_FOUND THEN
          v_AP_tolerance_value := 0.10;
        END;

        -- Loading Invoice only if Invoice total = Processed Amount otherwise Skip
        /* IF (l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTotal = l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).AmountProcessed) THEN */

		-- Modified Logic - Loading all Invoices with Invoice total and Processed Amount difference less than 10 cents otherwise Skip
        IF abs(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTotal - l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).AmountProcessed) <= v_AP_tolerance_value THEN
          v_batchId                                               := seq_IMPORT_SALES_DATA.nextval;
          v_tran_head_seq                                         :=0 ;
          v_tran_det_seq                                          :=0 ;
          v_tran_cust_seq                                         :=0 ;
          v_tran_tend_seq                                         :=0 ;
          v_tran_invoice_seq                                      :=0 ;
          v_tran_phone_seq                                        :=0 ;
          v_sales_det_ext_seq                                     :=0 ;
          v_sales_head_ext_seq                                    :=0 ;
          v_sales_tran_itemtrk_seq                                :=0 ;
          v_sales_dtl_item_seq                                    :=0 ;
          v_tran_line_tax_seq                                     :=0 ;
          v_tran_promo_seq                                        :=0 ;
          v_sales_tran_lineCharg_seq                              :=0 ;
          v_sales_det_itm_ext_seq                                 :=0;
		  v_sales_tran_return_seq                                 :=0;
          DBMS_OUTPUT.PUT_LINE('MIK_SALES_TRAN_CONTROL');
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CONTROL_INS Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' and Batch_id'|| ':'||v_batchId;
          utl_file.put_line(g_err_file_type, l_buffer);
          PROC_SALES_TRAN_CONTROL_INS( p_batchId => v_batchId, p_OrderId => l_order_object.OrderId, p_InvoiceId => l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId);
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_CONTROL_INS Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' and Batch_id'|| ':'||v_batchId;
          utl_file.put_line(g_err_file_type, l_buffer);
          v_ShipFromLocationId                                           := NULL;
          v_ShipToLocationId                                             := NULL;
          v_DeliveryMethodId                                             := NULL;
          v_FacilityId                                                   := NULL;
          IF l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_OrderLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL.COUNT > 0 AND l_ORDER_OBJECT.p_OrderLine_TBL.COUNT >0 THEN
            v_InvoiceId                                                  := 0;
            BEGIN
              SELECT DISTINCT ILT.ShipFromLocationId,
                ILT.ShipToLocationId,
                OLT.DeliveryMethodId,
                m2.RESA_VALUE
			 INTO v_ShipFromLocationId,
                v_ShipToLocationId,
                v_DeliveryMethodId,
                v_FacilityId
              FROM TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).p_InvoiceLine_TBL AS InvoiceLine_TBL)) ILT,
                TABLE(CAST(l_ORDER_OBJECT.p_OrderLine_TBL AS OrderLine_TBL)) OLT,
                mik_eref_map m1,
                mik_eref_map m2
              WHERE ILT.orderlineid  	= OLT.orderlineid

              AND m1.ref_code           = 'FCMP'
              AND Upper(m1.ECOM_VALUE)  = Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).OrgId)
              AND m2.ref_code           = m1.RESA_VALUE
              AND Upper(m2.ECOM_VALUE)  = Upper(OLT.DeliveryMethodId)
              AND Upper(m2.DESCRIPTION) = Upper(DECODE(OLT.DeliveryMethodId,'ShipToReturnCenter',DECODE(ILT.ShipToLocationId, '9490', '9490', '3490', '3490', NULL, '0', '1'), DECODE(ILT.ShipFromLocationId, '9490', '9490', '3490', '3490', NULL, '0', '1')))
              AND rownum             = 1
              ORDER BY DECODE(m2.RESA_VALUE,'9490',1,'3490',1,2); -- Precedence to Store_Id 9490 over all other
              DBMS_OUTPUT.PUT_LINE('v_FacilityId:' || v_FacilityId);
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has DeliveryMethodId' || ':'|| v_DeliveryMethodId || ', ShipFromLocationId' ||':' || v_ShipFromLocationId|| ', ShipToLocationId' ||':' || v_ShipToLocationId ||', FacilityId' ||':'|| v_FacilityId;
              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN -- Validating key column StoreId/FacilityId is not null.
              l_error_code := esb_api_codes.validation_failure;
              l_error_mesg := 'No rows returned for StoreId/FacilityId for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE validation_failure;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
              l_error_mesg := 'More than one row returned for FacilityId for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE too_many_rows;
            END;
          ELSE
            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'InvoiceLine_TBL and OrderLine_TBL is null for InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' and Orderlineid'||':'|| v_orderlineid;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;
          v_ExternalFacilityId := NULL;
          BEGIN
            SELECT DECODE(v_DeliveryMethodId,'ShipToReturnCenter',lpad(v_ShipToLocationId,5,0),lpad(NVL(v_ShipFromLocationId,v_ShipToLocationId),5,0))	/* Handled Null condition for ShipFromLocationId */
            INTO v_ExternalFacilityId
            FROM DUAL;
          EXCEPTION
          WHEN NO_DATA_FOUND THEN -- Validating key column StoreId/FacilityId is not null.
            NULL;
          WHEN TOO_MANY_ROWS THEN
            l_error_code := esb_api_codes.too_many_rows_err;
            l_error_mesg := 'More than one row returned for ExternalFacilityId for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
            RAISE too_many_rows;
          END;
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ExternalFacilityId' ||':'|| v_ExternalFacilityId;
          utl_file.put_line(g_err_file_type, l_buffer);
		  
		  --/* 1.12 */
		  v_Popupstore := NULL;
		  v_Popextstore :=NULL;
          BEGIN
            SELECT 0||CODE_TYPE,CODE
            INTO v_Popupstore,v_Popextstore
            FROM MIK_CODE_DETAIL where CODE_DESC='PUPSTORE';
          EXCEPTION
          WHEN NO_DATA_FOUND THEN 
            NULL;
          WHEN TOO_MANY_ROWS THEN
            l_error_code := esb_api_codes.too_many_rows_err;
            l_error_mesg := 'More than one row returned for popupstore for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
            RAISE too_many_rows;
          END;
		  l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has popup store' ||':'|| v_ExternalFacilityId;
          utl_file.put_line(g_err_file_type, l_buffer);
		  --/* 1.12 */
		  
          v_trantype                  := NULL;
          IF upper(v_DeliveryMethodID) = upper('Email') THEN
            v_trantype                :='ORDER';
            l_buffer                  := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has Trantype' ||':'|| v_trantype;
            utl_file.put_line(g_err_file_type, l_buffer);
          ELSE
            BEGIN
              SELECT upper(RESA_VALUE)
                INTO v_trantype
              FROM mik_eref_map
              WHERE ref_code        ='TRTY'
              AND ((upper(ECOM_VALUE) = upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId)
              AND Description is null)
              OR  (upper(ECOM_VALUE) = upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId)
              AND upper(Description) = case when l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTotal >= 0
											then 'POSITIVE'
											else 'NEGATIVE' end));
              l_buffer             := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has Trantype' ||':'|| v_trantype;
              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN
              l_error_code := esb_api_codes.validation_failure;
              l_error_mesg := 'No rows returned for TransactionType for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE validation_failure;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
              l_error_mesg := 'More than one row returned for TransactionType for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE too_many_rows;
            END;
          END IF;
          DBMS_OUTPUT.PUT_LINE('FacilityId:'||v_FacilityId||'trantype:'||v_trantype);
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has DeliveryMethodId' || ':'|| v_DeliveryMethodId || ', ShipFromLocationId' ||':' || v_ShipFromLocationId ||', FacilityId' ||':'|| v_FacilityId || ' and Trantype' ||':'|| v_trantype;
          utl_file.put_line(g_err_file_type, l_buffer);

          /* Overriding Transaction type from SHIPMENT to RETURN if Invoice Status is Canceled */

          /*IF Upper(v_trantype) = Upper('SHIPMENT') AND Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN
            v_trantype        :='RETURN';
            l_buffer          := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has been overidden with Trantype' ||':'|| v_trantype||' since the invoice status is : '||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;*/

		  /* Modified the logic to reverse transaction type for a canceled invoice through ref_code CTTR dynamically */
		  IF Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled') THEN
			l_buffer             := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has Trantype' ||':'|| v_trantype;
			utl_file.put_line(g_err_file_type, l_buffer);
			  BEGIN
				  SELECT distinct upper(RESA_VALUE)
					INTO v_trantype
				  FROM mik_eref_map
				  WHERE ref_code        ='CTTR'
				  AND upper(ECOM_VALUE) = Upper(v_trantype)
				  AND Upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId) = Upper('Canceled');

				EXCEPTION
				WHEN NO_DATA_FOUND THEN
				  l_error_code := esb_api_codes.validation_failure;
				  l_error_mesg := 'No rows returned for while decoding TransactionType for OrderId = ' || l_ORDER_OBJECT.OrderId ||' and Canceled Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
				  RAISE validation_failure;
				WHEN TOO_MANY_ROWS THEN
				  l_error_code := esb_api_codes.too_many_rows_err;
				  l_error_mesg := 'More than one row returned while decoding TransactionType for OrderId = ' || l_ORDER_OBJECT.OrderId ||' and Canceled Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
				  RAISE too_many_rows;
			  END;
			l_buffer          := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has been overidden with Trantype' ||':'|| v_trantype||' since the invoice status is : '||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).StatusId;
			utl_file.put_line(g_err_file_type, l_buffer);
          END IF;

          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has FulfillmentDate' || ':' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).FulfillmentDate;
          utl_file.put_line(g_err_file_type, l_buffer);
          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has CreatedTimestamp' || ':' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp;
          utl_file.put_line(g_err_file_type, l_buffer);
          IF l_ORDER_OBJECT.p_RelatedOrder_TBL IS NOT NULL AND l_ORDER_OBJECT.p_RelatedOrder_TBL.COUNT > 0 THEN
            FOR ro IN l_ORDER_OBJECT.p_RelatedOrder_TBL.FIRST .. l_ORDER_OBJECT.p_RelatedOrder_TBL.LAST
            LOOP
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has RO CreatedTimestamp' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).CreatedTimestamp;
              utl_file.put_line(g_err_file_type, l_buffer);
              l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ParentOrderId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).ParentOrderId || ' and RO OrderId' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).OrderId;
              utl_file.put_line(g_err_file_type, l_buffer);
              IF l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL IS NOT NULL AND l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL.COUNT > 0 THEN
                FOR ro_invoice IN l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL.FIRST .. l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL.LAST
                LOOP
                  l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has RO invoice Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).invoiceId;
                  utl_file.put_line(g_err_file_type, l_buffer);
                  IF l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL IS NOT NULL AND l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL.COUNT > 0 THEN
                    FOR ro_invoice_il IN l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL.FIRST .. l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL.LAST
                    LOOP
                      l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has RO Invoice Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).invoiceId|| ' and RO InvoiceLine Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).invoiceLineId|| ' and RO OrderLine Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).OrderLineId;
                      utl_file.put_line(g_err_file_type, l_buffer);
                      IF l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).p_ShipToAddress_Tbl IS NOT NULL AND l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).p_ShipToAddress_Tbl.COUNT > 0 THEN
                        FOR RO_ShipToAddr_Rec IN l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).p_ShipToAddress_Tbl.FIRST .. l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).p_ShipToAddress_Tbl.LAST
                        LOOP
                          l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has RO invoice Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).invoiceId|| ' and RO invoiceline Id' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).invoiceLineId|| ' and RO shippingaddr ' || ':' || l_ORDER_OBJECT.p_RelatedOrder_TBL(ro).p_Invoice_TBL(ro_invoice).p_InvoiceLine_TBL(ro_invoice_il).p_ShipToAddress_Tbl(RO_ShipToAddr_Rec).p_AddressDTO.Address1;
                          utl_file.put_line(g_err_file_type, l_buffer);
                        END LOOP; --ro shipping addr
                      END IF;
                    END LOOP; --ro invoiceline
                  END IF;
                END LOOP; --ro invoice
              END IF;
            END LOOP; --ro
          END IF;
          v_SHIPDATETIME   := NULL;
          v_RETURNDATETIME := NULL;
          --IF upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId) = upper('SHIPMENT') THEN
          IF upper(v_trantype) = upper('SHIPMENT') THEN
            /* Replaced direct value with place holder variable */
            v_SHIPDATETIME := l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).FulfillmentDate;
            l_buffer       := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ShipDateTime' ||':'|| l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).FulfillmentDate;
            utl_file.put_line(g_err_file_type, l_buffer);
            --ELSIF upper(l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceTypeId) IN (upper('Return')) THEN --upper('RETURN') THEN --creditmemo?
          ELSIF upper(v_trantype) IN (upper('Return')) THEN
            /* Replaced direct value with place holder variable */
            v_RETURNDATETIME := l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp;
            l_buffer         := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ReturnDateTime' ||':'|| l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).CreatedTimestamp;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;
          DBMS_OUTPUT.PUT_LINE('SHIPDATETIME: '||v_SHIPDATETIME||'RETURNDATETIME: '||v_RETURNDATETIME);
          v_ORIGINALTRANSACTIONDATETIME        := NULL;
          IF l_ORDER_OBJECT.p_RELATEDORDER_TBL IS NOT NULL AND l_ORDER_OBJECT.p_RELATEDORDER_TBL.COUNT > 0 THEN
            BEGIN
              SELECT ROT.createdTimestamp
              INTO v_ORIGINALTRANSACTIONDATETIME
              FROM TABLE(CAST(l_ORDER_OBJECT.p_Invoice_TBL AS Invoice_TBL)) IT,
                TABLE(CAST(l_ORDER_OBJECT.p_RELATEDORDER_TBL AS RELATEDORDER_TBL)) ROT
              WHERE IT.ParentOrderId = ROT.OrderId
              AND IT.InvoiceId       = l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
              l_buffer              := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has OriginalTransactionDateTime' || ':' || v_ORIGINALTRANSACTIONDATETIME;
              utl_file.put_line(g_err_file_type, l_buffer);
            EXCEPTION
            WHEN NO_DATA_FOUND THEN
              NULL;
            WHEN TOO_MANY_ROWS THEN
              l_error_code := esb_api_codes.too_many_rows_err;
              l_error_mesg := 'More than one row returned for ORIGINALTRANSACTIONDATETIME for OrderId = ' || l_ORDER_OBJECT.OrderId ||'Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || '. SQLERRM = ' || SQLERRM || 'Error raised: '|| DBMS_UTILITY.FORMAT_ERROR_BACKTRACE;
              RAISE too_many_rows;
            END;
            DBMS_OUTPUT.PUT_LINE('ORIGINALTRANSACTIONDATETIME: '||v_ORIGINALTRANSACTIONDATETIME);
          ELSE
            l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':'||'RELATEDORDER_TBL is null for OrderId'||':' ||l_ORDER_OBJECT.OrderId||' and Invoice Id = ' || l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
            utl_file.put_line(g_err_file_type, l_buffer);
          END IF;
          --l_buffer := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId || ' has ShipDateTime'||':'|| v_SHIPDATETIME || ', ReturnDateTime' ||':'|| v_RETURNDATETIME || ' and OriginalTransactionDateTime' || ':' || v_ORIGINALTRANSACTIONDATETIME;
          --utl_file.put_line(g_err_file_type, l_buffer);
          v_LoyaltyAccountNumber           := NULL;
          v_CompanyName                    := NULL;
          v_ORSOCode                       := NULL;
		  v_TaxExemptCode                  := NULL;
          v_ParentCustomerNumber           := NULL;
          v_ChildCustomerNumber            := NULL;
          v_PurchaseOrderNumber            := NULL;
          v_SalesPersonID                  := NULL;
          v_SalesPersonName                := NULL;
