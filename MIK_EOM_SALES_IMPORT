                          IF v_DeliveryMethodId = 'Email' AND V_EMAIL_SHIP_PH_FLAG = 0 THEN
                            l_buffer           := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_PHONE_INS (S-Email) Started for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
                            PROC_SALES_TRAN_PHONE_INS(p_batchId => v_batchId, p_FacilityId => v_FacilityId, p_InvoiceId => v_InvoiceId, p_AddressType => 'S', p_OrderlineId => v_OrderLineId, p_AddressDTO => l_ORDER_OBJECT.p_PaymentHeader_TBL(PaymentHeader_Rec).p_PaymentMethod_TBL(PaymentMethod_Rec).P_BillingAddress_TBL(BillingAddress_Rec).p_AddressDTO);
                            V_EMAIL_SHIP_PH_FLAG := 1;
                            l_buffer             := TO_CHAR(sysdate, 'dd-mm-yyyy hh24:mi:ss') ||':' ||'Sub Proc PROC_SALES_TRAN_PHONE_INS (S-Email) Completed Successfully for OrderId' || ':' || l_order_object.OrderId || ' and InvoiceId'||':' ||l_ORDER_OBJECT.p_Invoice_TBL(Invoice_Rec).InvoiceId;
                            utl_file.put_line(g_err_file_type, l_buffer);
